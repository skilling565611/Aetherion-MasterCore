<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootShell" prefHeight="820.0" prefWidth="1320.0" styleClass="app-root" stylesheets="@../styles/Main.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dev.aetherion.ui.dashboard.AetherionDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" minHeight="78.0" spacing="12.0" styleClass="top-bar">
            <padding>
                <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
            </padding>
            <VBox minWidth="245.0" spacing="2.0">
                <Label styleClass="app-title" text="AETHERION MASTERCORE" />
                <Label styleClass="app-subtitle" text="Offline AI Control Hub" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="status-pill-green" text="Local First" />
            <Label styleClass="status-pill-cyan" text="Dev Mode" />
            <Label styleClass="status-pill-amber" text="Safe Mode" />
            <TextField promptText="Search local systems" styleClass="search-field" HBox.hgrow="NEVER" />
            <Button onAction="#runDiagnostics" styleClass="primary-button" text="Run Diagnostics" />
            <Button onAction="#exitApplication" styleClass="danger-button" text="Exit" />
        </HBox>
    </top>

    <left>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll">
            <VBox spacing="10.0" styleClass="sidebar">
                <padding>
                    <Insets bottom="16.0" left="14.0" right="14.0" top="16.0" />
                </padding>
                <Label styleClass="nav-heading" text="Core" />
                <Button maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-button" text="Dashboard" />

                <Separator />
                <Label styleClass="nav-heading" text="AI Core" />
                <Button maxWidth="Infinity" onAction="#showAiCore" styleClass="nav-button" text="AI Core" />
                <Button maxWidth="Infinity" onAction="#showPlaceholder" styleClass="nav-button" text="Characters" />
                <Button maxWidth="Infinity" onAction="#showPlaceholder" styleClass="nav-button" text="Conversations" />
                <Button maxWidth="Infinity" onAction="#showPlaceholder" styleClass="nav-button" text="Memory" />

                <Separator />
                <Label styleClass="nav-heading" text="Systems" />
                <Button maxWidth="Infinity" onAction="#showSystems" styleClass="nav-button" text="Automation" />
                <Button maxWidth="Infinity" onAction="#showPlaceholder" styleClass="nav-button" text="Scripts" />
                <Button maxWidth="Infinity" onAction="#showPlaceholder" styleClass="nav-button" text="Plugins" />
                <Button maxWidth="Infinity" onAction="#showPlaceholder" styleClass="nav-button" text="Database" />
                <Button maxWidth="Infinity" onAction="#showSystems" styleClass="nav-button" text="Device Sync" />

                <Separator />
                <Label styleClass="nav-heading" text="Developer" />
                <Button maxWidth="Infinity" onAction="#showDeveloper" styleClass="nav-button" text="Debug Console" />
                <Button maxWidth="Infinity" onAction="#showDeveloper" styleClass="nav-button" text="Logs" />
                <Button maxWidth="Infinity" onAction="#showPlaceholder" styleClass="nav-button" text="Settings" />
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="workspace-scroll">
            <VBox spacing="16.0" styleClass="workspace">
                <padding>
                    <Insets bottom="22.0" left="22.0" right="22.0" top="24.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="muted-label" text="Active View:" />
                    <Label fx:id="activeViewLabel" styleClass="active-view-label" text="Dashboard" />
                </HBox>
                <VBox fx:id="centerWorkspace" maxWidth="Infinity" spacing="16.0" VBox.vgrow="ALWAYS" />
                <VBox maxWidth="Infinity" spacing="10.0" styleClass="ai-command-panel">
                    <Label styleClass="card-title" text="Local AI Command" />
                    <TextArea fx:id="aiCommandInput" maxWidth="Infinity" prefRowCount="4" promptText="Enter a local command for future offline routing." wrapText="true" VBox.vgrow="NEVER" />
                    <Button onAction="#sendAiCommand" styleClass="primary-button" text="Queue Local Command" />
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <right>
        <VBox minWidth="270.0" prefWidth="286.0" spacing="14.0" styleClass="right-rail">
            <padding>
                <Insets bottom="18.0" left="16.0" right="16.0" top="18.0" />
            </padding>
            <VBox maxWidth="Infinity" spacing="8.0" styleClass="rail-panel">
                <Label styleClass="rail-title" text="AI Status" />
                <Label fx:id="localAiStatus" styleClass="rail-body" text="AI Status: offline standby" wrapText="true" />
                <Label styleClass="status-line-green" text="No cloud API required" />
            </VBox>
            <VBox maxWidth="Infinity" spacing="8.0" styleClass="rail-panel">
                <Label styleClass="rail-title" text="Notifications" />
                <Label styleClass="rail-body" text="Shell locked for V1.0" wrapText="true" />
                <Label styleClass="rail-body" text="V2.0 center views planned" wrapText="true" />
            </VBox>
            <VBox maxWidth="Infinity" spacing="8.0" styleClass="rail-panel">
                <Label styleClass="rail-title" text="Runtime Statistics" />
                <Label styleClass="rail-body" text="Mode: Dev" />
                <Label styleClass="rail-body" text="Device: Control Prime" />
                <Label styleClass="rail-body" text="Network: Optional" />
                <Label styleClass="rail-body" text="Modules: Placeholder" />
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="footer-bar">
            <padding>
                <Insets bottom="8.0" left="18.0" right="18.0" top="8.0" />
            </padding>
            <Label styleClass="footer-label" text="Aetherion MasterCore V1.0" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="footerStatus" styleClass="footer-status" text="Offline runtime ready." />
        </HBox>
    </bottom>
</BorderPane>
